<%- include('partials/header.ejs') %>

<!-- Overlay for modal -->
<div class="overlay" id="overlay" onclick="toggleAddForm()"></div>

<!-- Slide-down Add Book Panel -->
<section class="add-book" id="add-book-panel">
    <div class="add-book-header">
        <h2>📖 Add a New Book</h2>
        <button class="close-btn" onclick="toggleAddForm()">&times;</button>
    </div>
    <form action="/add" method="POST">
        <div class="form-row">
            <input type="text" name="title" placeholder="📚 Book Title" required>
            <input type="text" name="author" placeholder="✍️ Author" required>
        </div>
        <div class="form-row">
            <div class="input-group">
                <input type="text" name="isbn" id="isbn-input" placeholder="🔢 ISBN (13 digits)" required 
                    pattern="\d{13}" 
                    title="ISBN must contain exactly 13 digits"
                    oninput="validateISBN(this)" 
                    oninvalid="this.setCustomValidity('Please enter exactly 13 digits')">
                <span id="isbn-counter" class="isbn-counter">0/13</span>
            </div>
            <input type="number" name="rating" id="rating-input" class="rating-input" placeholder="⭐ 1-10" min="1" max="10" step="1" required
                oninput="validateRating(this)">
            <input type="date" name="date_read" id="date_read" required>
        </div>
        <textarea name="notes" placeholder="✏️ Your notes and thoughts about this book..."></textarea>
        <button type="submit" class="submit-btn">Add to My Library</button>
    </form>
</section>

<section class="book-list">
    <% 
        function formatIsbn(isbn) {
            if (!isbn) return '';
            const digits = isbn.replace(/\D/g, '');
            if (digits.length !== 13) return isbn;
            const parts = [
                digits.slice(0, 3),
                digits.slice(3, 5),
                digits.slice(5, 7),
                digits.slice(7, 12),
                digits.slice(12)
            ];
            return parts.join('-');
        }
    %>
    <% if (books.length === 0) { %>
        <div class="empty-state">
            <p>📚 No books yet!</p>
            <p>Click <strong>"+ Add Book"</strong> to start building your library.</p>
        </div>
    <% } %>

    <% books.forEach(book => { %>
        <article class="book-card" id="book-<%= book.id %>">
            <div class="book-cover">
                <img src="https://covers.openlibrary.org/b/isbn/<%= book.isbn %>-M.jpg" 
                     alt="<%= book.title %> cover" 
                     onerror="this.onerror=null; this.src='/assets/no-cover.svg';"
                     onload="if(this.naturalWidth === 1 && this.naturalHeight === 1) { this.onload=null; this.src='/assets/no-cover.svg'; }">
                <div class="rating-badge"><%= book.rating %>/10</div>
            </div>
            <div class="book-info">
                <h3><%= book.title %></h3>
                <p class="author">by <%= book.author %></p>
                <p class="meta">ISBN: <%= formatIsbn(book.isbn) %></p>
                <p class="meta">📅 <%= new Date(book.date_read).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></p>
                
                <div class="notes-container">
                    <p id="notes-text-<%= book.id %>" class="notes-text"><%= book.notes %></p>
                    
                    <form action="/edit" method="POST" id="edit-form-<%= book.id %>" class="edit-form">
                        <input type="hidden" name="id" value="<%= book.id %>">
                        <textarea name="notes" required><%= book.notes %></textarea>
                        <div class="edit-meta">
                            <label for="rating-<%= book.id %>">⭐ Rating:</label>
                            <input type="number" id="rating-<%= book.id %>" name="rating" value="<%= book.rating %>" min="1" max="10" required>
                        </div>
                        <div class="edit-buttons">
                            <button type="submit" class="save-btn">💾 Save</button>
                            <button type="button" class="cancel-btn" onclick="toggleEdit('<%= book.id %>')">Cancel</button>
                        </div>
                    </form>
                </div>

                <div class="actions" id="actions-<%= book.id %>">
                    <button class="edit-btn" onclick="toggleEdit('<%= book.id %>')">✏️ Edit</button>
                    <form action="/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this book?')">
                        <input type="hidden" name="id" value="<%= book.id %>">
                        <button type="submit" class="delete-btn">🗑️ Delete</button>
                    </form>
                </div>
            </div>
        </article>
    <% }) %>
</section>

<script>
    function toggleEdit(id) {
        const text = document.getElementById(`notes-text-${id}`);
        const form = document.getElementById(`edit-form-${id}`);
        const actions = document.getElementById(`actions-${id}`);
        
        if (form.classList.contains('visible')) {
            form.classList.remove('visible');
            text.style.display = 'block';
            actions.style.display = 'flex';
        } else {
            form.classList.add('visible');
            text.style.display = 'none';
            actions.style.display = 'none';
        }
    }

    function toggleAddForm() {
        const panel = document.getElementById('add-book-panel');
        const overlay = document.getElementById('overlay');
        panel.classList.toggle('open');
        overlay.classList.toggle('visible');
    }

    // Zamknij panel po naciśnięciu Escape
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            const panel = document.getElementById('add-book-panel');
            const overlay = document.getElementById('overlay');
            if (panel.classList.contains('open')) {
                panel.classList.remove('open');
                overlay.classList.remove('visible');
            }
        }
    });

    // Ustaw domyślną i maksymalną datę na dzisiaj
    (function() {
        const today = new Date().toISOString().split('T')[0];
        const dateInput = document.getElementById('date_read');
        dateInput.value = today;
        dateInput.max = today;
    })();

    function validateISBN(input) {
        input.setCustomValidity('');
        const feedback = document.getElementById('isbn-counter');
        
        // Remove non-digits and limit to 13 characters
        let value = input.value.replace(/\D/g, '');
        if (value.length > 13) {
            value = value.slice(0, 13);
        }
        input.value = value;

        const length = value.length;
        
        if (length === 0) {
            feedback.textContent = '0/13';
            feedback.className = 'isbn-counter';
        } else if (length < 13) {
            feedback.textContent = `${length}/13`;
            feedback.className = 'isbn-counter invalid';
        } else if (length === 13) {
            feedback.textContent = '✔';
            feedback.className = 'isbn-counter valid';
        }
    }

    function validateRating(input) {
        // Remove non-numeric characters
        let value = input.value.replace(/[^0-9]/g, '');
        
        // Convert to number and clamp between 1-10
        let num = parseInt(value, 10);
        if (isNaN(num)) {
            input.value = '';
        } else if (num < 1) {
            input.value = 1;
        } else if (num > 10) {
            input.value = 10;
        } else {
            input.value = num;
        }
    }
</script>

<%- include('partials/footer.ejs') %>
